[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/gui/meta_upgrades.gd" id="1"]

[node name="MetaUpgrades" type="CanvasLayer"]
script = ExtResource("1")

[node name="Panel" type="Panel" parent="."]
offset_left = 24.0
offset_top = 24.0
offset_right = 520.0
offset_bottom = 320.0

[node name="VBoxContainer" type="VBoxContainer" parent="Panel"]
offset_left = 12.0
offset_top = 12.0
offset_right = 472.0
offset_bottom = 272.0
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Panel/VBoxContainer"]
text = "Meta Upgrades"

[node name="CurrencyLabel" type="Label" parent="Panel/VBoxContainer"]
text = "Meta Currency: 0"

[node name="SummaryLabel" type="Label" parent="Panel/VBoxContainer"]
text = "HP 100 | Move 400 | Jump 800 | Crit 0.00 | DR 0.000"
autowrap_mode = 3

[node name="HPButton" type="Button" parent="Panel/VBoxContainer"]
text = "HP Lv.0 | HP 100 -> 110 | Cost 5"

[node name="MoveSpeedButton" type="Button" parent="Panel/VBoxContainer"]
text = "Move Speed Lv.0 | Move 400 -> 408 | Cost 5"

[node name="JumpButton" type="Button" parent="Panel/VBoxContainer"]
text = "Jump Lv.0 | Jump 800 -> 820 | Cost 4"

[node name="CritButton" type="Button" parent="Panel/VBoxContainer"]
text = "Crit Rate Lv.0 | Crit 0.00 -> 0.01 | Cost 8"

[node name="DRButton" type="Button" parent="Panel/VBoxContainer"]
text = "Damage Reduction Lv.0 | DR 0.000 -> 0.005 | Cost 10"

[node name="CloseButton" type="Button" parent="Panel/VBoxContainer"]
text = "Close"

[connection signal="pressed" from="Panel/VBoxContainer/HPButton" to="." method="_on_hp_button_pressed"]
[connection signal="pressed" from="Panel/VBoxContainer/MoveSpeedButton" to="." method="_on_move_speed_button_pressed"]
[connection signal="pressed" from="Panel/VBoxContainer/JumpButton" to="." method="_on_jump_button_pressed"]
[connection signal="pressed" from="Panel/VBoxContainer/CritButton" to="." method="_on_crit_button_pressed"]
[connection signal="pressed" from="Panel/VBoxContainer/DRButton" to="." method="_on_dr_button_pressed"]
[connection signal="pressed" from="Panel/VBoxContainer/CloseButton" to="." method="_on_close_button_pressed"]
